---
import fs from 'node:fs';
import path from 'node:path';
import * as yaml from 'js-yaml';

const dataDir = path.resolve(process.cwd(), 'data');
const load = (file) => yaml.load(fs.readFileSync(path.join(dataDir, `${file}.yml`), 'utf8')) ?? [];

const sections = load('sections');
const dataMap = {
  educations: load('educations'),
  works: load('works'),
  projects: load('projects'),
  skills: load('skills'),
};

const md = (s) =>
  String(s ?? '')
    .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

const host = (url) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return String(url ?? '');
  }
};

const linkifyUrls = (s) =>
  String(s ?? '').replace(
    /(https?:\/\/[^\s]+)/g,
    (m) => `<a href="${m}" target="_blank" rel="noopener">${host(m)}</a>`
  );

const profile = {
  name: 'Arman Adhitama Prawirasasra',
  shortName: 'Pakmann',
  title: 'Full Stack Web Developer',
  email: 'arman.adhitama@gmail.com',
  phone: '+6289676676869',
  location: 'Bandung, Indonesia',
  linkedin: 'https://www.linkedin.com/in/armanadhitama',
  website: 'https://pakmann.cv',
  summary: `As a passionate Full Stack Developer, I bring extensive experience in designing and maintaining web applications across front-end and back-end environments. Proficient in modern technologies like HTML, CSS/Scss/Sass, JavaScript (Vue, Node.js), and Ruby (RoR), I excel at building dynamic, user-friendly, and scalable applications. With expertise in database management (SQL, MongoDB) and version control (Git), I ensure seamless integration, troubleshoot issues effectively, and deliver optimal user experiences.

I have hands-on experience in creating RESTful APIs, implementing authentication and authorization, and following Agile practices to deliver high-quality software. My familiarity with cloud platforms (AWS, Heroku) and containerization tools (Docker) enables me to build efficient and scalable solutions.`,
};

const works = dataMap.works ?? [];
const projects = dataMap.projects ?? [];
const skills = dataMap.skills ?? [];
const educations = dataMap.educations ?? [];

const nav = [
  { file: 'works', title: 'Employment' },
  { file: 'projects', title: 'Projects' },
  { file: 'skills', title: 'Skills' },
  { file: 'educations', title: 'Education' },
  { file: 'contact', title: 'Contact' },
];

const date = new Date().toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={`${profile.name} — ${profile.title}`} />
    <title>{profile.shortName} — {profile.title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=Instrument+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      /* ============================================================
         1. Tokens
      ============================================================ */
      :root {
        --cream: #f1ecdf;
        --surface: #ffffff;
        --ink: #262626;
        --ink-soft: #57534a;
        --muted: #7a7267;
        --yellow: #ffdc61;
        --line: rgba(38, 38, 38, 0.14);
        --font-display: "Fraunces", Georgia, "Times New Roman", serif;
        --font-body: "Instrument Sans", "Helvetica Neue", Arial, system-ui, sans-serif;
        --container: 1120px;
        --section-space: clamp(88px, 12vh, 150px);
        --ease: cubic-bezier(0.215, 0.61, 0.355, 1);
      }

      /* ============================================================
         2. Reset & base
      ============================================================ */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 92px;
      }

      body {
        margin: 0;
        background:
          radial-gradient(circle at 8% 6%, rgba(255, 220, 97, 0.16), transparent 34rem),
          radial-gradient(circle at 96% 24%, rgba(38, 38, 38, 0.05), transparent 30rem),
          var(--cream);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 17px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      ::selection {
        background: var(--yellow);
        color: var(--ink);
      }

      :focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .container {
        max-width: var(--container);
        margin: 0 auto;
        padding: 0 28px;
      }

      /* ============================================================
         3. Decorative blobs
      ============================================================ */
      .blob {
        position: absolute;
        color: var(--ink);
        pointer-events: none;
        z-index: 0;
      }

      .blob svg {
        display: block;
        width: 100%;
        height: 100%;
      }

      .blob.is-yellow {
        color: var(--yellow);
        opacity: 0.9;
      }

      .blob.is-ink {
        color: var(--ink);
        opacity: 0.06;
      }

      .blob.is-ink-strong {
        color: var(--ink);
        opacity: 0.08;
      }

      /* ============================================================
         4. Header & nav
      ============================================================ */
      .site-head {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--cream) 88%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }

      .head-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 14px 0;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .brand-mark {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: var(--surface);
        border: 1px solid var(--line);
        padding: 4px;
        flex: none;
      }

      .brand-mark img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .brand-name {
        font-family: var(--font-display);
        font-size: 20px;
        font-weight: 400;
        letter-spacing: 0.01em;
        line-height: 1;
      }

      .brand-name em {
        font-style: italic;
        color: var(--ink-soft);
      }

      .nav {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        justify-content: flex-end;
      }

      .nav a {
        font-size: 13.5px;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--ink-soft);
        padding: 7px 14px;
        border-radius: 999px;
        transition: background 0.25s var(--ease), color 0.25s var(--ease);
      }

      .nav a:hover {
        background: rgba(38, 38, 38, 0.07);
        color: var(--ink);
      }

      @media (max-width: 640px) {
        .head-inner {
          flex-direction: column;
          align-items: flex-start;
          gap: 10px;
        }

        .nav {
          overflow-x: auto;
          -ms-overflow-style: none;
          scrollbar-width: none;
          justify-content: flex-start;
          max-width: 100%;
        }

        .nav::-webkit-scrollbar {
          display: none;
        }
      }

      /* ============================================================
         5. Hero
      ============================================================ */
      .hero {
        position: relative;
        padding: clamp(56px, 9vw, 96px) 0 var(--section-space);
        text-align: center;
        overflow: hidden;
      }

      .hero .blob-hero-a {
        width: clamp(220px, 40vw, 460px);
        top: -40px;
        left: -120px;
      }

      .hero .blob-hero-b {
        width: clamp(160px, 26vw, 300px);
        bottom: -60px;
        right: -80px;
        color: var(--yellow);
        opacity: 0.55;
      }

      .hero-content {
        position: relative;
        z-index: 1;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .eyebrow::before,
      .eyebrow::after {
        content: "";
        width: 26px;
        height: 1px;
        background: var(--ink);
        opacity: 0.28;
      }

      .hero-title {
        font-family: var(--font-display);
        font-weight: 300;
        font-size: clamp(2.7rem, 6.2vw, 5.6rem);
        line-height: 1.04;
        letter-spacing: -0.02em;
        text-wrap: balance;
        max-width: 900px;
        margin: 22px auto 0;
      }

      .hero-title em {
        font-style: italic;
        font-weight: 300;
        color: var(--ink);
      }

      .hero-byline {
        margin: 22px auto 0;
        font-size: 15px;
        font-weight: 500;
        color: var(--ink-soft);
        max-width: 560px;
      }

      .hero-byline b {
        font-weight: 700;
        color: var(--ink);
      }

      .hero-intro {
        margin: 26px auto 0;
        max-width: 640px;
        font-size: 17px;
        line-height: 1.7;
        color: var(--ink-soft);
        text-align: left;
      }

      .hero-intro p {
        margin: 0 0 16px;
      }

      .hero-intro p:last-child {
        margin-bottom: 0;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 34px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.01em;
        padding: 13px 26px;
        border-radius: 999px;
        border: 1.5px solid var(--ink);
        background: var(--ink);
        color: var(--surface);
        cursor: pointer;
        transition:
          background 0.35s var(--ease),
          color 0.35s var(--ease),
          border-color 0.35s var(--ease),
          transform 0.2s var(--ease);
      }

      .btn:hover {
        background: var(--yellow);
        border-color: var(--yellow);
        color: var(--ink);
        transform: translateY(-1px);
      }

      .btn.ghost {
        background: transparent;
        color: var(--ink);
      }

      .btn.ghost:hover {
        background: var(--ink);
        border-color: var(--ink);
        color: var(--surface);
      }

      /* Logo plate — the identity anchor, no box (ref: main .mast-logo) */
      .logo-plate {
        position: relative;
        width: clamp(180px, 28vw, 280px);
        aspect-ratio: 1;
        margin: clamp(48px, 8vh, 72px) auto 0;
      }

      .logo-plate::before,
      .logo-plate::after {
        content: "";
        position: absolute;
        inset: 0;
        margin: auto;
        width: 80%;
        aspect-ratio: 1;
        background-repeat: no-repeat;
        background-position: center;
        background-size: contain;
        pointer-events: none;
      }

      .logo-plate::before {
        background-image: url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 288 288%27%3E%3Cpath d=%27M146.5 1.3c6.8.8 13.4 2.3 20.1 3.8C184 9 207.7 16 221.1 27.9s9.3 10.5 14 15.6c10.7 11.4 21.6 17.5 30.6 31.2 9.4 14.3 15.3 27.1 18.7 44.1 1.2 6.1 2.3 12.1 3.2 18.2s.5 7.6 0 10-2.1 6.3-3.4 9.4c-2.7 6.2-7 11.8-9.6 18.1-5 12.2-1.6 25.4-6.1 37.6s-29.7 36.3-39.9 45.5c-18.9 17.1-38.8 18.9-62.4 25.5 0 0-14.7 3.1-19.7 3.7s-6.8.3-9 0c-4.4-.7-8.7-2.1-13.1-3.3-6.2-1.7-12.2-4.1-18.4-5.7-13.4-3.5-24.1-4.2-36.7-11-24-13-40.6-29.7-51.1-55.4-4.2-10.4-3.3-20.7-6-31.1-1.8-7.1-5.7-13.7-8.2-20.5s-2.9-7.3-3.6-11.2-.5-7.2 0-9.5c.8-3.9 2.1-7.6 3.4-11.4 2.1-6.5 5.1-12.6 6.9-19.2 5-18.4 3.3-29 16.3-44.9s32.8-30.8 53.4-42c18.8-10.5 37.8-18.4 59.1-20.3 1.8-.2 5.3-.2 7 0%27 style=%27fill:%23e4523d%27/%3E%3C/svg%3E');
        animation: spin-cw 22s linear infinite;
      }

      .logo-plate::after {
        background-image: url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 288 288%27%3E%3Cpath d=%27M143 5.2c1.2 0 2.4 0 3 .1 6.4.8 12.6 2.1 19.1 3.6h.6c24.6 5.6 42.8 13.2 52.7 22 8.4 7.4 9.5 9.3 10.4 10.9.7 1.1 1.4 2.4 3.3 4.4 4.1 4.4 8.2 8 12.2 11.4 6.5 5.7 12.6 11.1 18 19.2 9.8 14.9 15 27.2 18.1 42.7 1.4 7.2 2.4 12.7 3.2 18 .8 5.2.5 6.4 0 8.3v.3c-.5 2.2-2.3 6.5-3.2 8.6-1.2 2.7-2.8 5.4-4.4 8.2-1.8 3.1-3.8 6.4-5.2 9.9-2.8 6.9-3.2 13.9-3.6 20.7-.3 6-.6 11.7-2.6 17-3.9 10.5-26.2 32.6-38.8 43.9-14.4 13-29.5 16.7-46.9 21-4.4 1.1-9 2.2-13.7 3.5-1.4.3-14.7 3.1-19.2 3.6-1.8.2-3.2.3-4.4.3s-2.2-.1-3.3-.3h-.2c-3.1-.5-6.2-1.4-9.5-2.3-1.1-.3-2.1-.6-3.2-.9-2.8-.8-5.7-1.7-8.4-2.6-3.2-1.1-6.6-2.2-10-3.1-3.8-1-7.4-1.8-10.9-2.5-8.8-1.9-16.3-3.5-24.9-8.1-24.4-13.2-39.6-29.7-49.3-53.4-2.3-5.6-2.9-11.2-3.6-17.2-.5-4.3-1-8.8-2.2-13.4-1.2-4.7-3.2-9-5.1-13.3-1.2-2.6-2.3-5.1-3.2-7.6-.5-1.5-1-2.7-1.4-3.7-1.3-3.5-1.6-4.2-2.1-6.9-.7-3.8-.3-6.6 0-8 .7-3.4 1.8-6.7 3-10.3l.2-.6c.9-2.7 1.9-5.3 3-8 1.4-3.6 2.9-7.4 4-11.4 1.4-5.2 2.3-9.9 3.1-14 2.1-10.9 3.6-18.7 12.4-29.4 12-14.7 30.5-29.2 52.3-41C103.9 12.7 121.7 6.6 139.8 5c.7 0 1.9-.1 3.1-.1m.1-3.8c-1.3 0-2.6 0-3.5.1-21.3 1.9-40.3 9.8-59.1 20.3C59.8 32.7 40 47.6 27 63.5S15.7 90 10.7 108.4c-1.8 6.6-4.8 12.7-6.9 19.2-1.3 3.8-2.6 7.5-3.4 11.4-.5 2.3-.7 5.6 0 9.5s1.1 4.4 3.6 11.2 6.4 13.4 8.2 20.5c2.7 10.4 1.8 20.7 6 31.1 10.5 25.7 27.1 42.4 51.1 55.4 12.6 6.8 23.3 7.5 36.7 11 6.2 1.6 12.2 4 18.4 5.7 4.4 1.2 8.7 2.6 13.1 3.3 1.3.2 2.4.3 4.1.3s2.8 0 4.9-.3c5-.6 19.7-3.7 19.7-3.7 23.6-6.6 43.5-8.4 62.4-25.5 10.2-9.2 35.4-33.3 39.9-45.5s1.1-25.4 6.1-37.6c2.6-6.3 6.9-11.9 9.6-18.1 1.3-3.1 2.9-7 3.4-9.4s.9-3.9 0-10-2-12.1-3.2-18.2c-3.4-17-9.3-29.8-18.7-44.1-9-13.7-19.9-19.8-30.6-31.2-4.7-5.1-.6-3.7-14-15.6S184 8.9 166.6 5c-6.7-1.5-13.3-3-20.1-3.8-.8 0-2.1-.1-3.5-.1%27 style=%27fill:%23231f20%27/%3E%3C/svg%3E');
        animation: spin-ccw 26s linear infinite;
      }

      .logo-plate img {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .logo-plate:hover::before {
        animation:
          spin-cw 22s linear infinite,
          pulse-jitter 1.2s ease-in-out infinite;
      }

      .logo-plate:hover::after {
        animation:
          spin-ccw 26s linear infinite,
          pulse-jitter 1.6s ease-in-out 0.15s infinite;
      }

      @keyframes spin-cw {
        to {
          transform: rotate(360deg);
        }
      }

      @keyframes spin-ccw {
        to {
          transform: rotate(-360deg);
        }
      }

      @keyframes pulse-jitter {
        0% {
          width: 80%;
        }
        10% {
          width: 75%;
        }
        20% {
          width: 85%;
        }
        30% {
          width: 80%;
        }
        40% {
          width: 70%;
        }
        50% {
          width: 65%;
        }
        60% {
          width: 75%;
        }
        70% {
          width: 70%;
        }
        80% {
          width: 75%;
        }
        90% {
          width: 70%;
        }
        100% {
          width: 65%;
        }
      }

      /* ============================================================
         6. Sections
      ============================================================ */
      section.section {
        position: relative;
        padding: var(--section-space) 0;
      }

      section.section + section.section {
        border-top: 1px solid var(--line);
      }

      .sec-head {
        margin: 0 0 clamp(34px, 5vw, 52px);
        max-width: 720px;
      }

      .sec-head h2 {
        font-family: var(--font-display);
        font-weight: 300;
        font-size: clamp(2.1rem, 4vw, 3.1rem);
        line-height: 1.12;
        letter-spacing: -0.01em;
        text-wrap: balance;
        margin: 0;
      }

      .sec-head h2 em {
        font-style: italic;
        color: var(--ink-soft);
      }

      .sec-head .sec-sub {
        margin: 12px 0 0;
        font-size: 16px;
        color: var(--ink-soft);
        max-width: 58ch;
      }

      /* ============================================================
         7. Works — ordered sequence
      ============================================================ */
      .work {
        display: grid;
        grid-template-columns: clamp(52px, 8vw, 96px) 1fr;
        gap: clamp(20px, 4vw, 44px);
        padding: clamp(28px, 4vw, 40px) 0;
        border-top: 1px solid var(--line);
      }

      .work:first-of-type {
        border-top: none;
        padding-top: 0;
      }

      .work:last-of-type {
        padding-bottom: 0;
      }

      .work .num {
        font-family: var(--font-display);
        font-weight: 300;
        font-size: clamp(2.4rem, 4.5vw, 3.8rem);
        line-height: 1;
        letter-spacing: -0.03em;
        color: var(--yellow);
        padding-top: 2px;
        user-select: none;
      }

      .work .num .dot {
        color: var(--ink);
        opacity: 0.25;
      }

      .work-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px 18px;
      }

      .work-role {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.3rem, 2.6vw, 1.75rem);
        line-height: 1.25;
        letter-spacing: 0;
        margin: 0;
      }

      .work-role .co {
        font-style: italic;
        font-weight: 300;
        color: var(--ink-soft);
      }

      .period {
        flex: none;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink);
        background: var(--yellow);
        padding: 4px 14px;
        border-radius: 999px;
        white-space: nowrap;
      }

      .work-where {
        margin: 8px 0 0;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .work-body {
        margin: 14px 0 0;
        font-size: 16.5px;
        color: var(--ink);
        max-width: 72ch;
        overflow-wrap: anywhere;
      }

      .work-body p {
        margin: 0 0 12px;
      }

      .work-body p:last-child {
        margin-bottom: 0;
      }

      .work-body a {
        color: var(--ink-soft);
        border-bottom: 1px solid var(--line);
        transition: color 0.2s, border-color 0.2s;
      }

      .work-body a:hover {
        color: var(--ink);
        border-color: var(--ink);
      }

      .work-label {
        display: inline-block;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin: 0 8px 0 0;
      }

      .work-pf {
        margin: 14px 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .work-pf a,
      .pill {
        display: inline-flex;
        align-items: center;
        font-size: 13px;
        font-weight: 500;
        color: var(--ink-soft);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 5px 14px;
        transition: border-color 0.2s, color 0.2s, background 0.2s;
      }

      .work-pf a:hover {
        border-color: var(--ink);
        color: var(--ink);
      }

      .stacks {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
      }

      .pill:hover {
        border-color: var(--ink);
        color: var(--ink);
      }

      @media (max-width: 560px) {
        .work {
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .work .num {
          font-size: 1.9rem;
        }
      }

      /* ============================================================
         8. Projects — panels
      ============================================================ */
      .project-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
      }

      @media (max-width: 760px) {
        .project-grid {
          grid-template-columns: 1fr;
        }
      }

      .project {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 26px 26px 22px;
        min-width: 0;
        position: relative;
        transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
      }

      .project:hover {
        border-color: rgba(38, 38, 38, 0.34);
        transform: translateY(-2px);
      }

      .project .p-meta {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
      }

      .project .p-year {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink);
        background: var(--yellow);
        border-radius: 999px;
        padding: 3px 11px;
        white-space: nowrap;
      }

      .project h3 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.45rem;
        line-height: 1.2;
        margin: 16px 0 6px;
      }

      .project h3 a {
        transition: color 0.2s;
      }

      .project h3 a:hover {
        color: var(--ink-soft);
      }

      .project .p-url {
        font-size: 13px;
        color: var(--muted);
        overflow-wrap: anywhere;
        margin: 0 0 12px;
      }

      .project .p-url a {
        border-bottom: 1px solid var(--line);
        transition: color 0.2s, border-color 0.2s;
      }

      .project .p-url a:hover {
        color: var(--ink);
        border-color: var(--ink);
      }

      .project .p-desc {
        margin: 0;
        font-size: 15.5px;
        color: var(--ink-soft);
        line-height: 1.6;
        overflow-wrap: anywhere;
      }

      .project .p-desc a {
        border-bottom: 1px solid var(--line);
      }

      /* ============================================================
         9. Skills
      ============================================================ */
      .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: clamp(28px, 5vw, 56px);
      }

      .skill-group h3 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.35rem;
        line-height: 1.2;
        margin: 0 0 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--line);
      }

      .skill-group h3::before {
        content: "◆ ";
        font-size: 0.72em;
        color: var(--yellow);
      }

      .skill-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .skill-list li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 14px;
        padding: 8px 0;
        border-bottom: 1px dashed var(--line);
        font-size: 15.5px;
      }

      .skill-list li:last-child {
        border-bottom: none;
      }

      .skill-list .score {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--ink-soft);
        white-space: nowrap;
      }

      .skill-list .score b {
        color: var(--ink);
      }

      /* ============================================================
         10. Education
      ============================================================ */
      .edu {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 8px 20px;
        padding: 22px 0;
        border-top: 1px solid var(--line);
      }

      .edu:first-of-type {
        border-top: none;
        padding-top: 0;
      }

      .edu h3 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.4rem;
        margin: 0;
      }

      .edu .meta {
        font-size: 14.5px;
        color: var(--ink-soft);
      }

      .edu .period {
        background: transparent;
        border: 1px solid var(--line);
        color: var(--ink-soft);
        text-transform: none;
        letter-spacing: 0.02em;
        font-weight: 600;
      }

      /* ============================================================
         11. Contact — want ad
      ============================================================ */
      .wantad {
        position: relative;
        background: var(--surface);
        border: 2px solid var(--ink);
        border-radius: 14px;
        text-align: center;
        padding: clamp(44px, 7vw, 72px) clamp(26px, 6vw, 64px);
      }

      .wantad .blob-ad {
        width: 120px;
        top: -46px;
        left: -36px;
        color: var(--yellow);
        opacity: 0.8;
      }

      .wantad .wantad-inner {
        position: relative;
        z-index: 1;
      }

      .wantad h2 {
        font-family: var(--font-display);
        font-weight: 300;
        font-size: clamp(2rem, 4.6vw, 3.2rem);
        line-height: 1.12;
        letter-spacing: -0.01em;
        text-wrap: balance;
        margin: 16px 0 12px;
      }

      .wantad h2 em {
        font-style: italic;
      }

      .wantad .wantad-copy {
        margin: 0 auto 30px;
        max-width: 46ch;
        color: var(--ink-soft);
        font-size: 16px;
      }

      .wantad .hero-actions {
        margin-top: 0;
      }

      /* ============================================================
         12. Footer
      ============================================================ */
      .site-foot {
        border-top: 1px solid var(--line);
        padding: 26px 0 40px;
        margin-top: calc(var(--section-space) * 0.4);
      }

      .foot-inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 12px 24px;
        font-size: 13px;
        color: var(--muted);
      }

      .foot-inner .socials {
        display: flex;
        gap: 20px;
      }

      .foot-inner a {
        color: var(--muted);
        transition: color 0.2s;
      }

      .foot-inner a:hover {
        color: var(--ink);
      }

      /* ============================================================
         13. Motion
      ============================================================ */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <!-- ============ HEADER / NAV ============ -->
    <header class="site-head">
      <div class="container head-inner">
        <a class="brand" href="#front" aria-label="Pakmann — home">
          <span class="brand-mark"><img src="/pakmann.png" alt="" /></span>
          <span class="brand-name">Pak<em>mann</em></span>
        </a>
        <nav class="nav" aria-label="Primary">
          {nav.map((n) => (
            <a href={`#${n.file}`}>{n.title}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero" id="front">
        <span class="blob is-ink-strong blob-hero-a" aria-hidden="true">
          <svg viewBox="0 0 200 200" fill="currentColor">
            <path
              d="M100 8C145 8 180 42 185 88C190 134 168 178 122 190C76 202 24 186 14 140C4 94 30 44 74 20C82 16 91 8 100 8Z"
            />
          </svg>
        </span>
        <span class="blob is-yellow blob-hero-b" aria-hidden="true">
          <svg viewBox="0 0 200 200" fill="currentColor">
            <path
              d="M102 6C148 8 187 40 194 86C201 132 172 184 126 193C80 202 20 186 10 138C0 90 32 40 78 18C85 14 96 5 102 6Z"
            />
          </svg>
        </span>

        <div class="container hero-content">
          <p class="eyebrow reveal">Est. 2008 · {profile.location}</p>
          <h1 class="hero-title reveal">
            The Developer Who Builds <em>Fast, Scalable &amp; Human</em> Web Applications
          </h1>
          <p class="hero-byline reveal">
            By <b>{profile.name}</b> · {profile.title} · {profile.location}
          </p>
          <div class="hero-intro reveal">
            {profile.summary.split('\n\n').map((para) => <p>{para}</p>)}
          </div>
          <div class="hero-actions reveal">
            <a class="btn" href={`mailto:${profile.email}`}>Reply by Mail</a>
            <a
              class="btn ghost"
              href={`https://wa.me/${profile.phone.replace(/\D/g, '')}`}
              target="_blank"
              rel="noopener"
            >WhatsApp</a
            >
            <a class="btn ghost" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>

        <div class="logo-plate reveal">
          <img src="/pakmann.png" alt="Pakmann logo" />
        </div>
      </section>

      <!-- ============ EMPLOYMENT ============ -->
      <section class="section" id="works">
        <div class="container">
          <div class="sec-head reveal">
            <p class="eyebrow">Employment</p>
            <h2><em>Where</em> I've worked</h2>
            <p class="sec-sub">Seventeen years in the trade — from first frontend bytes in 2008 to full-stack and AI today.</p>
          </div>

          <div class="reveal-group">
            {works.map((w, i) => (
              <article class="work reveal-item">
                <span class="num" aria-hidden="true">{i + 1}<span class="dot">.</span></span>
                <div>
                  <div class="work-head">
                    <h3 class="work-role">
                      {w.title}
                      {w.company ? <span class="co">, {w.company}</span> : ''}
                    </h3>
                    <span class="period">{w.period}</span>
                  </div>
                  <p class="work-where">
                    {w.location}
                    {w.employment ? ` · ${w.employment}` : ''}
                  </p>

                  {w.about && <div class="work-body"><p set:html={md(w.about)} /></div>}

                  {w.objectives && (
                    <div class="work-body">
                      <p>
                        <span class="work-label">Responsibilities</span>
                        <span set:html={md(w.objectives)} />
                      </p>
                    </div>
                  )}

                  {w.achievements && (
                    <div class="work-body">
                      <p>
                        <span class="work-label">Achievements</span>
                        <span set:html={md(w.achievements)} />
                      </p>
                    </div>
                  )}

                  {w.portfolios && (
                    <div class="work-pf">
                      {w.portfolios.map((p) => {
                        const text = typeof p === 'string' ? p : p.desc;
                        const url = text && text.startsWith('http') ? text.trim().replace(/;\s*$/, '') : null;
                        return url ? (
                          <a href={url} target="_blank" rel="noopener">{host(url)}</a>
                        ) : (
                          <span class="pill">{text}</span>
                        );
                      })}
                    </div>
                  )}

                  {w.stacks && (
                    <div class="stacks">
                      {w.stacks.split(',').map((s) => (
                        <span class="pill">{s.trim()}</span>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ PROJECTS ============ -->
      <section class="section" id="projects">
        <div class="container">
          <div class="sec-head reveal">
            <h2>Other <em>projects</em></h2>
            <p class="sec-sub">Selected builds across e-commerce, media, SaaS, and bespoke client work.</p>
          </div>

          <div class="project-grid reveal-group">
            {projects.map((p) => (
              <article class="project reveal-item">
                <div class="p-meta">
                  {p.url ? (
                    <a class="p-year" href={p.url} target="_blank" rel="noopener">{p.year}</a>
                  ) : (
                    <span class="p-year">{p.year}</span>
                  )}
                </div>
                <h3>
                  {p.url ? (
                    <a href={p.url} target="_blank" rel="noopener">{p.title}</a>
                  ) : (
                    p.title
                  )}
                </h3>
                {p.url && (
                  <p class="p-url"><a href={p.url} target="_blank" rel="noopener">{host(p.url)}</a></p>
                )}
                {p.about && <p class="p-desc" set:html={md(p.about)} />}
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ SKILLS ============ -->
      <section class="section" id="skills">
        <div class="container">
          <div class="sec-head reveal">
            <h2>Skills <em>quotes</em></h2>
            <p class="sec-sub">The instruments I reach for, roughly ranked by how often they earn their keep.</p>
          </div>

          <div class="skills-grid reveal-group">
            {skills.map((g) => (
              <div class="skill-group reveal-item">
                <h3>{g.group}</h3>
                <ul class="skill-list">
                  {g.softwares.map((s) => (
                    <li>
                      <span>{s.name}</span>
                      {typeof s.score === 'number' && (
                        <span class="score"><b>{s.score}</b>/5</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ EDUCATION ============ -->
      <section class="section" id="educations">
        <div class="container">
          <div class="sec-head reveal">
            <h2>Education <em>briefs</em></h2>
          </div>

          <div class="reveal-group">
            {educations.map((e) => (
              <div class="edu reveal-item">
                <div>
                  <h3>{e.school}</h3>
                  <div class="meta">
                    {e.type}
                    {e.location ? ` — ${e.location}` : ''}
                  </div>
                </div>
                <span class="period">{e.period}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ CONTACT ============ -->
      <section class="section" id="contact">
        <div class="container">
          <div class="wantad reveal">
            <span class="blob is-yellow blob-ad" aria-hidden="true">
              <svg viewBox="0 0 200 200" fill="currentColor">
                <path
                  d="M102 6C148 8 187 40 194 86C201 132 172 184 126 193C80 202 20 186 10 138C0 90 32 40 78 18C85 14 96 5 102 6Z"
                />
              </svg>
            </span>
            <div class="wantad-inner">
              <p class="eyebrow">Want ad</p>
              <h2>Wanted: a <em>great project</em></h2>
              <p class="wantad-copy">
                Full-stack developer with over 17 years in the trade, seeking interesting
                opportunities. Open to full-time, contract, and remote work.
              </p>
              <div class="hero-actions">
                <a class="btn" href={`mailto:${profile.email}`}>Reply by Mail</a>
                <a
                  class="btn ghost"
                  href={`https://wa.me/${profile.phone.replace(/\D/g, '')}`}
                  target="_blank"
                  rel="noopener"
                >WhatsApp</a
                >
                <a class="btn ghost" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="site-foot">
      <div class="container foot-inner">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <span>Vol. XVII · No. 01 · {date}</span>
        <div class="socials">
          <a href={profile.linkedin}>LinkedIn</a>
          <a href={`https://wa.me/${profile.phone.replace(/\D/g, '')}`}>WhatsApp</a>
          <a href={`mailto:${profile.email}`}>Email</a>
        </div>
      </div>
    </footer>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReduced) {
        gsap.utils.toArray('.reveal').forEach((el) => {
          gsap.fromTo(
            el,
            { opacity: 0, y: 26 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'power2.out',
              scrollTrigger: { trigger: el, start: 'top 92%' },
            }
          );
        });

        gsap.utils.toArray('.reveal-group').forEach((group) => {
          const items = group.querySelectorAll('.reveal-item');
          if (!items.length) return;
          gsap.fromTo(
            items,
            { opacity: 0, y: 22 },
            {
              opacity: 1,
              y: 0,
              duration: 0.7,
              ease: 'power2.out',
              stagger: 0.07,
              scrollTrigger: { trigger: group, start: 'top 88%' },
            }
          );
        });
      }

      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = link.getAttribute('href');
          if (id.length > 1) {
            const target = document.querySelector(id);
            if (target) {
              e.preventDefault();
              target.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth' });
            }
          }
        });
      });
    </script>
  </body>
</html>
